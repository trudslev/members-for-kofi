#: src/Admin/AdminSettings.php:537
msgid "Map Ko-fi tiers to WordPress roles. Only exact tier names will be matched."
msgstr "Knyt Ko-fi-niveauer til WordPress-roller. Kun niveaunavne, der er helt ens, matcher."

#: src/Admin/AdminSettings.php:554
msgid "— No default —"
msgstr "— Ingen standard —"

#: src/Admin/AdminSettings.php:563
msgid "If no tier matches, or if you are not using tiers, this role will be assigned to the user."
msgstr "Hvis intet niveau matcher, eller hvis du ikke bruger niveauer, får brugeren denne rolle."

#: src/Admin/AdminSettings.php:594
msgid "Number of days the role remains active (only used if expiry is enabled)."
msgstr "Antal dage rollen er aktiv (bruges kun, når udløb er slået til)."

#: src/Admin/AdminSettings.php:606
msgid "Enable automatic deletion of old logs based on retention period."
msgstr "Slet automatisk logs, der er ældre end opbevaringsperioden."

#: src/Admin/AdminSettings.php:618
msgid "Number of days to keep logs before automatic deletion (minimum 1 day)."
msgstr "Antal dage, logs gemmes, før de slettes automatisk (mindst 1 dag)."

