#. Plugin URI of the plugin
#: members-for-kofi.php
msgid "https://github.com/trudslev/members-for-kofi"
msgstr "https://github.com/trudslev/members-for-kofi"

#. Description of the plugin
#: members-for-kofi.php
msgid "Integrate with Ko-fi to manage WordPress users or roles via webhook."
msgstr "Forbind Ko-fi med WordPress, så brugere og roller kan administreres via webhooks."

#. Author of the plugin
#: members-for-kofi.php
msgid "Sune Adelowo Trudslev"
msgstr "Sune Adelowo Trudslev"

