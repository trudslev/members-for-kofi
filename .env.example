# You can override these if using an external MySQL
WORDPRESS_DB_HOST=db
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
WORDPRESS_DB_NAME=wordpress_test
WORDPRESS_TEST_DB_NAME=wordpress_test

# Port the local test site is published on (docker-compose.test.yml).
# `make test-integration` builds the URL from this and passes it to PHPUnit, so
# there is deliberately no WP_TEST_SITE_URL here: a stale value in .env would
# point the suite -- which posts real donations and creates users -- at whatever
# site it named. Override the port, not the URL.
WP_TEST_PORT=8101

# Verification token configured on the local test site. Not a secret.
KOFI_TEST_TOKEN=test-verification-token

# WordPress.org SVN credentials (used by: make commit-svn)
WPORG_USER=
WPORG_PASS=
